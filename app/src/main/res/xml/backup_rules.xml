<?xml version="1.0" encoding="utf-8"?>
<!-- Health records, reports and memory stay on this phone: never in Android backup (Android 11 and older). -->
<full-backup-content>
    <exclude domain="sharedpref" path="nila_memory.xml" />
    <exclude domain="sharedpref" path="nila_memory_secure.xml" />
    <exclude domain="sharedpref" path="nila_health.xml" />
    <exclude domain="sharedpref" path="nila_reminders.xml" />
    <exclude domain="sharedpref" path="nila_reminders_secure.xml" />
    <exclude domain="sharedpref" path="nila_memory_key.xml" />
    <exclude domain="database" path="nila_memory.db" />
    <exclude domain="database" path="nila_memory.db-journal" />
    <exclude domain="database" path="nila_memory.db-wal" />
    <exclude domain="database" path="nila_memory.db-shm" />
    <exclude domain="file" path="health/" />
</full-backup-content>
