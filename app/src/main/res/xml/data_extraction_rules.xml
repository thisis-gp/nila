<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. My NILA's personal and health data stays off backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nila_memory.xml" />
        <exclude domain="sharedpref" path="nila_memory_secure.xml" />
        <exclude domain="sharedpref" path="nila_health.xml" />
        <exclude domain="file" path="health/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nila_memory.xml" />
        <exclude domain="sharedpref" path="nila_memory_secure.xml" />
        <exclude domain="sharedpref" path="nila_health.xml" />
        <exclude domain="file" path="health/" />
    </device-transfer>
</data-extraction-rules>
